{
  "schema_version": 3,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "Durable job lifecycle",
    "locale": "en",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "retry",
        "label": "Retry path",
        "focus": [
          "result",
          "wait",
          "run"
        ],
        "note": "A transient result can retry only while attempts remain."
      }
    ]
  },
  "mainPath": [
    "accepted",
    "run",
    "result",
    "done"
  ],
  "states": [
    {
      "id": "accepted",
      "type": "start",
      "label": "Accepted",
      "sublabel": "Capacity reserved",
      "tag": "Job progression"
    },
    {
      "id": "run",
      "type": "active",
      "label": "Running",
      "sublabel": "Attempt in progress",
      "tag": "Job progression"
    },
    {
      "id": "result",
      "type": "decision",
      "label": "Result",
      "sublabel": "Outcome classified",
      "tag": "Job progression"
    },
    {
      "id": "done",
      "type": "success",
      "label": "Complete",
      "sublabel": "Output durable",
      "tag": "Job progression"
    },
    {
      "id": "wait",
      "type": "waiting",
      "label": "Retry wait",
      "sublabel": "Transient failure",
      "tag": "Recovery event"
    },
    {
      "id": "failed",
      "type": "failure",
      "label": "Failed",
      "sublabel": "Permanent failure",
      "tag": "Failed outcome"
    }
  ],
  "transitions": [
    {
      "id": "phase-run",
      "from": "accepted",
      "to": "run"
    },
    {
      "id": "phase-result",
      "from": "run",
      "to": "result"
    },
    {
      "id": "phase-done",
      "from": "result",
      "to": "done"
    },
    {
      "id": "transient",
      "from": "result",
      "to": "wait",
      "variant": "dashed"
    },
    {
      "id": "retry",
      "from": "wait",
      "to": "run",
      "variant": "emphasis"
    },
    {
      "id": "permanent",
      "from": "result",
      "to": "failed",
      "variant": "security"
    }
  ],
  "cards": [
    {
      "dot": "amber",
      "title": "Retry is conditional",
      "items": [
        "The retry event must be due and attempts remain.",
        "A permanent failure terminates the job instead of entering the retry loop.",
        "Admission reserves capacity before execution begins."
      ]
    }
  ]
}
