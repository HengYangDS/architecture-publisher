{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://architecture-publisher.local/schemas/model.json",
  "title": "Architecture Publisher model",
  "description": "An explicit architecture of one repository: components, relations, sources and optional editorial decisions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "id", "title", "question", "components", "relations"],
  "properties": {
    "format": {
      "const": "architecture-publisher.model"
    },
    "version": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "title": {
      "$ref": "#/$defs/text"
    },
    "question": {
      "$ref": "#/$defs/text"
    },
    "summary": {
      "$ref": "#/$defs/text"
    },
    "attribution": {
      "$ref": "#/$defs/text"
    },
    "scope": {
      "$ref": "#/$defs/text"
    },
    "limits": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "revision"],
      "properties": {
        "name": {
          "$ref": "#/$defs/text"
        },
        "url": {
          "$ref": "#/$defs/text"
        },
        "revision": {
          "type": "string",
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
        }
      }
    },
    "kinds": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "label": {
            "$ref": "#/$defs/text"
          },
          "category": {
            "enum": [
              "person",
              "external",
              "frontend",
              "backend",
              "database",
              "cloud",
              "messagebus",
              "security"
            ]
          },
          "icon": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        }
      }
    },
    "sources": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path"],
        "properties": {
          "path": {
            "$ref": "#/$defs/path"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "note": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "label": {
            "$ref": "#/$defs/text"
          },
          "kind": {
            "$ref": "#/$defs/id"
          },
          "details": {
            "$ref": "#/$defs/details"
          },
          "status": {
            "$ref": "#/$defs/status"
          },
          "sources": {
            "$ref": "#/$defs/references"
          }
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "from", "to", "label"],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "from": {
            "$ref": "#/$defs/id"
          },
          "to": {
            "$ref": "#/$defs/id"
          },
          "label": {
            "$ref": "#/$defs/text"
          },
          "details": {
            "$ref": "#/$defs/details"
          },
          "status": {
            "$ref": "#/$defs/status"
          },
          "sources": {
            "$ref": "#/$defs/references"
          }
        }
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "members"],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "label": {
            "$ref": "#/$defs/text"
          },
          "members": {
            "$ref": "#/$defs/references",
            "minItems": 1
          }
        }
      }
    },
    "views": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "oneOf": [
          {
            "required": ["tiers"]
          },
          {
            "required": ["members"]
          }
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "title": {
            "$ref": "#/$defs/text"
          },
          "question": {
            "$ref": "#/$defs/text"
          },
          "summary": {
            "$ref": "#/$defs/text"
          },
          "tiers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                {
                  "$ref": "#/$defs/id"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "label", "members"],
                  "properties": {
                    "id": {
                      "$ref": "#/$defs/id"
                    },
                    "label": {
                      "$ref": "#/$defs/text"
                    },
                    "members": {
                      "$ref": "#/$defs/references",
                      "minItems": 1
                    }
                  }
                }
              ]
            }
          },
          "members": {
            "$ref": "#/$defs/references",
            "minItems": 1
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "\\S"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*(^|/)\\.\\.?(/|$))[^\\\\\\u0000\\n\\r]+$"
    },
    "status": {
      "enum": ["implemented", "planned", "retired"]
    },
    "references": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "details": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^(?![0-9]+$)[^:\\n]{1,64}$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "$ref": "#/$defs/text"
          },
          {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/text"
            }
          }
        ]
      }
    }
  }
}
