digraph architecture {
graph [rankdir=LR, bgcolor="#fffefa", pad="0.2", nodesep="0.30", ranksep="0.75", splines=polyline, outputorder=edgesfirst];
node [shape=box, style="rounded,filled", fillcolor="#fffefa", color="#84978a", penwidth=1.3, fontname="Helvetica", fontsize=14, margin="0.18,0.12"];
edge [color="#60786a", fontcolor="#27352e", penwidth=1.2, fontname="Helvetica", fontsize=10, arrowsize=0.65];
"n-0" [label="Adapter contract"];
"n-1" [label="Claude Code"];
"n-2" [label="Claude Desktop"];
