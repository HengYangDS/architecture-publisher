{
  "name": "architecture-publisher",
  "version": "0.14.0",
  "description": "Publish a repository's architecture model as a print edition and an interactive page",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HengYangDS/architecture-publisher.git"
  },
  "type": "module",
  "bin": {
    "archpub": "src/cli/main.mjs"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "renderers/",
    "supplies/",
    "skills/",
    "README.md"
  ],
  "scripts": {
    "generate": "node tools/supply/likec4.mjs --write",
    "test": "node --import=./tests/fixtures/npm-environment.mjs --test --test-concurrency=2 --test-force-exit tests/*.test.mjs",
    "check": "npm run check:static && npm run test:coverage && npm run check:package",
    "check:static": "npm run check:generated && npm run check:format && npm run check:lint && npm run check:types && npm run check:imports && npm run check:dead-code && npm run check:docs && npm run check:spec",
    "check:generated": "node tools/release/version.mjs --check && npm run check:ci && node tools/supply/likec4.mjs --check && node tools/supply/icons.mjs --check",
    "check:format": "prettier --config .config/checks/prettier/prettier.toml --ignore-path .gitignore --ignore-path .config/checks/prettier/prettierignore --check . && taplo format --config .config/checks/taplo/taplo.toml --check",
    "check:lint": "eslint --config .config/checks/eslint/eslint.config.mjs . --max-warnings 0",
    "check:types": "tsc --project .config/checks/typescript/tsconfig.json --noEmit",
    "check:imports": "node --test tests/module-boundaries.test.mjs",
    "check:dead-code": "knip --config .config/checks/knip/knip.toml && knip --config .config/checks/knip/knip.toml --production --strict --include files,unlisted,unresolved,cycles,exports,nsExports",
    "check:docs": "markdownlint-cli2 --config .config/checks/markdownlint-cli2/.markdownlint-cli2.yaml",
    "check:spec": "openspec validate --all --strict --no-interactive",
    "test:coverage": "c8 --config .config/checks/c8/.c8rc.json npm test",
    "check:package": "node tools/checks/package.mjs",
    "check:ci": "node tools/ci/projection.mjs --check",
    "format": "prettier --config .config/checks/prettier/prettier.toml --ignore-path .gitignore --ignore-path .config/checks/prettier/prettierignore --write . && taplo format --config .config/checks/taplo/taplo.toml"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fission-ai/openspec": "2.0.0",
    "@likec4/language-services": "1.60.0",
    "@types/node": "26.6.6",
    "bundle-require": "5.1.0",
    "c8": "12.0.0",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "knip": "6.44.2",
    "lucide-static": "1.70.0",
    "markdownlint-cli2": "0.24.0",
    "opentype.js": "2.0.0",
    "playwright-core": "1.65.0",
    "prettier": "3.9.10",
    "publint": "0.3.25",
    "semver": "7.8.6",
    "smol-toml": "1.9.1",
    "typescript": "7.0.2",
    "yaml": "2.9.1"
  },
  "overrides": {
    "glob": "14.0.3",
    "katex": "0.19.1",
    "markdownlint": {
      "re2js": "2.9.1"
    },
    "minimatch": "11.0.4"
  },
  "packageManager": "npm@12.2.2",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "12.2.2",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=22.13"
  }
}
