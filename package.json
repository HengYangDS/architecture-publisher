{
  "name": "architecture-publisher-workspace",
  "version": "0.2.0-alpha.0",
  "private": true,
  "description": "Architecture Publisher product and first-party conformance workspace",
  "type": "module",
  "workspaces": [
    "packages/publisher",
    "editions/self",
    "migration/ethos"
  ],
  "scripts": {
    "test": "node --test --test-concurrency=2 tests/*.test.mjs",
    "check": "npm run check:syntax && npm run check:dead-code",
    "check:syntax": "node tools/check-syntax.mjs",
    "check:dead-code": "knip --config knip.json && knip --config knip.json --production --strict --include files,unlisted,unresolved,cycles,exports,nsExports"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "acorn": "8.18.0",
    "playwright-core": "1.63.0",
    "knip": "6.37.0"
  },
  "packageManager": "npm@11.19.1"
  ,
  "engines": {
    "node": ">=22"
  }
}
