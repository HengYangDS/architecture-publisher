{
  "name": "architecture-publisher-workspace",
  "private": true,
  "description": "Architecture Publisher product and first-party conformance workspace",
  "type": "module",
  "workspaces": [
    "packages/publisher",
    "editions/self"
  ],
  "scripts": {
    "generate": "node tools/raster/resvg/verify.mjs --stage && node tools/generate-authoring-validators.mjs --write && node tools/supply/likec4.mjs --write",
    "test": "node --import=./tests/fixtures/npm-environment.mjs --test --test-concurrency=2 tests/*.test.mjs",
    "check": "npm run check:static && npm run test:coverage && npm run check:package",
    "check:static": "npm run check:generated && npm run check:format && npm run check:lint && npm run check:types && npm run check:imports && npm run check:dead-code && npm run check:docs && npm run check:spec",
    "check:generated": "node tools/release/version.mjs --check && npm run check:ci && node tools/generate-authoring-validators.mjs --check && node tools/supply/likec4.mjs --check && node tools/supply/interactive.mjs --check && node tools/supply/elk.mjs --check && node tools/supply/avoid.mjs --check && node tools/supply/dagre.mjs --check && node tools/supply/icons.mjs --check && node tools/supply/resvg.mjs --check && node tools/supply/implementation.mjs --check",
    "check:format": "prettier --config .config/checks/prettier/prettier.toml --ignore-path .gitignore --ignore-path .config/checks/prettier/prettierignore --check . && taplo format --config .config/checks/taplo/taplo.toml --check",
    "check:lint": "eslint --config .config/checks/eslint/eslint.config.mjs . --max-warnings 0",
    "check:types": "tsc --project .config/checks/typescript/tsconfig.json --noEmit",
    "check:imports": "node --test tests/module-boundaries.test.mjs tests/module-execution-boundaries.test.mjs",
    "check:dead-code": "knip --config .config/checks/knip/knip.toml && knip --config .config/checks/knip/knip.toml --production --strict --workspace \"!.\" --include files,unlisted,unresolved,cycles,exports,nsExports",
    "check:docs": "markdownlint-cli2 --config .config/checks/markdownlint-cli2/.markdownlint-cli2.yaml",
    "check:spec": "openspec validate --all --strict --no-interactive",
    "test:coverage": "c8 --config .config/checks/c8/.c8rc.json npm test",
    "check:package": "publint packages/publisher",
    "check:ci": "node tools/ci/projection.mjs --check",
    "format": "prettier --config .config/checks/prettier/prettier.toml --ignore-path .gitignore --ignore-path .config/checks/prettier/prettierignore --write . && taplo format --config .config/checks/taplo/taplo.toml"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@dagrejs/dagre": "3.1.3",
    "@eslint/js": "10.0.1",
    "@exodus/schemasafe": "1.3.0",
    "@fission-ai/openspec": "1.15.0",
    "@likec4/language-services": "1.60.0",
    "@types/node": "26.6.5",
    "@types/punycode": "2.1.4",
    "acorn": "8.19.0",
    "axe-core": "4.14.0",
    "bundle-require": "5.1.0",
    "c8": "12.0.0",
    "elkjs": "0.12.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "knip": "6.43.0",
    "libavoid-js": "0.4.5",
    "lucide-static": "1.61.0",
    "markdownlint-cli2": "0.24.0",
    "npm": "12.2.1",
    "opentype.js": "2.0.0",
    "playwright-core": "1.64.1",
    "prettier": "3.9.10",
    "publint": "0.3.25",
    "sax": "1.6.1",
    "semver": "7.8.5",
    "smol-toml": "1.9.1",
    "svg-pan-zoom": "3.6.2",
    "typescript": "7.0.2",
    "yaml": "2.9.1"
  },
  "overrides": {
    "lodash-es": "4.18.1"
  },
  "packageManager": "npm@12.2.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.12.1",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "12.2.1",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
