    },
    {
      "id": "sandbox",
      "title": "Redirect into the sandbox",
      "question": "How is a call that would flood the context run in a subprocess so that only its printed output returns?",
      "summary": "The PreToolUse hook denies WebFetch, and curl or wget calls that would print a page, with guidance to use the ctx_* tools. ctx_execute runs code in a subprocess; output over 100 KB is indexed and only a pointer returns.",
      "tiers": [
        {
          "id": "entry",
          "label": "Hook and server",
          "members": ["pretool-hook", "mcp-server"]
        },
        {
          "id": "steps",
