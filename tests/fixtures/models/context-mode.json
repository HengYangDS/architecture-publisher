  "views": [
    {
      "id": "overview",
      "title": "Overview",
      "question": "Which parts keep bulky tool output out of the agent's context, and how is it found again?",
      "members": [
        "agent-host",
        "pretool-hook",
        "routing-engine",
        "mcp-server",
        "executor",
        "content-store",
        "search-layer",
