          "members": ["routing-engine", "executor"]
        },
        {
          "id": "below",
          "label": "Policy and processes",
          "members": ["security-policy", "lang-runtimes", "web-origins"]
        }
      ]
    },
    {
      "id": "retrieval",
      "title": "Retrieve and resume",
      "question": "How do indexed output and session events come back as small slices sized to a query?",
      "summary": "A search returns short snippets from the content store and the session store and is blocked after eight calls in a minute. Session hooks record tool events and build a resume snapshot before compaction.",
      "tiers": [
        {
          "id": "entry",
          "label": "Server and hooks",
          "members": ["mcp-server", "session-hooks"]
        },
        {
          "id": "steps",
          "label": "Search and capture",
          "members": ["search-layer", "event-extractor", "snapshot-builder"]
        },
        {
          "id": "stores",
          "label": "Stores",
          "members": ["content-store", "session-db"]
        }
      ]
    }
