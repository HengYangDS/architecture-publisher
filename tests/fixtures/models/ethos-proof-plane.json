{
  "format": "architecture-publisher.model",
  "version": 3,
  "id": "ethos",
  "title": "ETHOS",
  "question": "How does ETHOS turn official intent and fresh facts into proven repository change, and what does it hold every repository to?",
  "summary": "ETHOS compiles an OpenSpec Change, fresh facts and prior Attestations into a TransitionPlan, admits each effect only on a pass, and holds every governed repository, itself included, to one declared structure.",
  "scope": "The ETHOS product as released at v0.2.0-alpha.28: the src/ethos package, its system declarations, the npm launcher and the repository's own .ethos binding.",
  "limits": [
    "Each component cites every file the rules attribute to it; a relation cites the modules that import the other component.",
    "Relations are imports and process calls in the source, not runtime order or design intent."
  ],
  "editors": [
    {
      "name": "Architecture Publications"
    }
  ],
  "kinds": {
    "surface": {
      "label": "surface",
      "category": "frontend",
      "icon": "square-terminal"
    },
    "service": {
      "label": "ETHOS module",
      "category": "backend",
      "icon": "workflow"
    },
    "admission": {
      "label": "admission",
      "category": "security",
      "icon": "shield-check"
    },
    "policy": {
      "label": "policy",
      "category": "security",
      "icon": "list-checks"
    },
    "store": {
      "label": "Git-common store",
      "category": "database",
      "icon": "database"
    },
    "tool": {
      "label": "external tool",
      "category": "external",
      "icon": "wrench"
    }
  },
  "components": [
    {
      "id": "cli",
      "label": "CLI",
      "kind": "surface",
      "details": {
        "commands": "status, plan, prove, land, publish, adopt, lane, hook, attestation, mcp",
        "launcher": "a thin npm package over the Python command plane"
      }
    },
    {
      "id": "openspec-intent",
      "label": "OpenSpec intent",
      "kind": "service",
      "details": {
        "compiles": "the official Change into a Commitment",
        "archives": "a completed Change with exact relocations"
      }
    },
    {
      "id": "gate-policy",
      "label": "Gate policy",
      "kind": "policy",
      "details": {
        "declares": "system/gates.toml and the profile's repository gates",
        "binds": "execution identities to selected sources"
      }
    },
    {
      "id": "quality-policy",
      "label": "Quality obligations",
      "kind": "policy",
      "details": {
        "judges": "coverage, tests, dependencies and source budgets from native reports"
      }
    },
    {
      "id": "gate-runner",
      "label": "Gate runner",
      "kind": "service",
      "details": {
        "runs": "the admitted gate DAG, bounded readers and exclusive writers",
        "admits": "one full proof per host under its load limit"
      }
    },
    {
      "id": "native-evidence",
      "label": "Native evidence",
      "kind": "service",
      "details": {
        "captures": "each native tool's output once, with its receipts",
        "covers": "Python, JavaScript, formatting, configuration and provenance"
      }
    },
    {
      "id": "proof",
      "label": "Proof Attestation",
      "kind": "service",
      "details": {
        "command": "ethos prove",
        "issues": "a proof Attestation for the exact HEAD"
      }
    },
    {
      "id": "prewrite-admission",
      "label": "Prewrite admission",
      "kind": "admission",
      "details": {
        "command": "ethos lane prewrite",
        "admits": "exact tracked write paths and patches"
      }
    },
    {
      "id": "mutation-admission",
      "label": "Mutation decision",
      "kind": "admission",
      "details": {
        "requires": "--authorize, --expect-head and current facts",
        "names": "the bounded recovery for each gap"
      }
    },
    {
      "id": "work-lane",
      "label": "Work Lane",
      "kind": "service",
      "details": {
        "commands": "lane start, refresh-base, archive-change",
        "starts": "an owned branch and worktree from the candidate"
      }
    },
    {
      "id": "landing",
      "label": "Landing and acceptance",
      "kind": "service",
      "details": {
        "command": "ethos land",
        "promotes": "a proven lane to candidate, then dev, then main"
      }
    },
    {
      "id": "git-effects",
      "label": "Git effect engine",
      "kind": "service",
      "details": {
        "executes": "exact compare-and-swap ref, worktree and merge effects, then attests them"
      }
    },
    {
      "id": "attestation-set",
      "label": "Attestation set",
      "kind": "store",
      "details": {
        "holds": "the only persistent semantic results, a Git-native set"
      }
    },
    {
      "id": "evidence-store",
      "label": "Evidence custody",
      "kind": "store",
      "details": {
        "holds": "content-addressed evidence bytes bound by Attestation members"
      }
    },
    {
      "id": "native-tools",
      "label": "Native tools",
      "kind": "tool",
      "details": {
        "for example": "pytest, ruff, ty, eslint, vale, mise"
      }
    }
  ],
