{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "forceConsistentCasingInFileNames": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "maxNodeModuleJsDepth": 0,
    "noEmit": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2024",
    "types": ["node"]
  },
  "typeAcquisition": {
    "enable": false
  },
  "include": ["../../../packages/publisher/src/**/*.mjs"],
  "exclude": ["../../../build/**", "../../../node_modules/**"]
}
