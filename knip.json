{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "treatConfigHintsAsErrors": true,
  "workspaces": {
    ".": {
      "entry": [
        "conformance/journeys/provider/run.mjs",
        "conformance/journeys/self-host/build.mjs",
        "tools/migration/semantic-v1-to-claim-v2.mjs",
        "tools/qualification/semantic-browser.mjs",
        "tests/*.test.mjs"
      ],
      "project": [
        "conformance/journeys/provider/**/*.mjs",
        "conformance/journeys/self-host/**/*.mjs",
        "tools/**/*.mjs",
        "tests/**/*.mjs"
      ],
      "includeEntryExports": true
    },
    "packages/publisher": {
      "project": ["src/**/*.mjs", "renderers/**/*.mjs"],
      "ignore": ["renderers/*/supply/**"],
      "includeEntryExports": false
    },
    "editions/self": {
      "project": ["src/**/*.mjs"],
      "includeEntryExports": false
    }
  }
}
