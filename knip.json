{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "treatConfigHintsAsErrors": true,
  "workspaces": {
    ".": {
      "entry": [
        "conformance/journeys/self-host/build.mjs",
        "tools/migration/semantic-v1-to-claim-v2.mjs",
        "tools/qualification/browser-run.mjs",
        "tools/qualification/installed-evolution.mjs",
        "tools/qualification/semantic-browser.mjs",
        "tests/*.test.mjs"
      ],
      "project": [
        "conformance/journeys/self-host/**/*.mjs",
        "tools/**/*.mjs",
        "tests/**/*.mjs"
      ],
      "includeEntryExports": true
    },
    "packages/publisher": {
      "project": [
        "src/**/*.mjs",
        "renderers/**/*.mjs"
      ],
      "ignore": [
        "renderers/*/supply/**"
      ],
      "includeEntryExports": false
    },
    "editions/self": {
      "project": [
        "src/**/*.mjs"
      ],
      "includeEntryExports": false
    },
    "migration/ethos": {
      "project": [
        "src/**/*.mjs"
      ],
      "includeEntryExports": false
    }
  }
}
