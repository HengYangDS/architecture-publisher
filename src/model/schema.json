{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://architecture-publisher.local/schemas/model.json",
  "title": "Architecture Publisher model",
  "description": "An explicit architecture of one repository: components, relations, the files they own and cite, and optional editorial decisions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "id", "title", "question", "components", "relations"],
  "properties": {
    "$schema": {
      "description": "The schema an editor checks the model against; the publisher ignores it.",
      "type": "string"
    },
    "format": {
      "const": "architecture-publisher.model"
    },
    "version": {
      "const": 3
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "locale": {
      "description": "The language the model is written in; the publisher sets its own words in it. Defaults to en.",
      "enum": ["en", "zh-CN", "zh-TW", "es", "ko"]
    },
    "title": {
      "$ref": "#/$defs/text"
    },
    "question": {
      "$ref": "#/$defs/text"
    },
    "summary": {
      "$ref": "#/$defs/text"
    },
    "editors": {
      "description": "The editors of this model, each by name and optionally a URL.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": {
            "$ref": "#/$defs/text"
          },
          "url": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "license": {
      "description": "The licence of this model and its editions, as an SPDX licence expression.",
      "type": "string",
      "pattern": "^\\(?[A-Za-z0-9.+-]+\\)?(?: (?:AND|OR|WITH) \\(?[A-Za-z0-9.+-]+\\)?)*$"
    },
    "scope": {
      "$ref": "#/$defs/text"
    },
    "limits": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "revision"],
      "properties": {
        "name": {
          "$ref": "#/$defs/text"
        },
        "url": {
          "$ref": "#/$defs/text"
        },
        "revision": {
          "type": "string",
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "browse": {
          "description": "A URL that shows one file of the repository at one revision, with the placeholders {revision} and {path}.",
          "type": "string",
          "pattern": "\\{revision\\}[\\s\\S]*\\{path\\}|\\{path\\}[\\s\\S]*\\{revision\\}"
        }
      }
    },
    "kinds": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "label": {
            "$ref": "#/$defs/text"
          },
          "category": {
            "enum": [
              "person",
              "external",
              "frontend",
              "backend",
              "database",
              "cloud",
              "messagebus",
              "security"
            ]
          },
          "icon": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "label": {
            "$ref": "#/$defs/text"
          },
          "kind": {
            "$ref": "#/$defs/id"
          },
          "details": {
            "$ref": "#/$defs/details"
          },
          "status": {
            "$ref": "#/$defs/status"
          },
          "files": {
            "description": "The repository paths the component owns: a directory ending in a slash or one file, each claimed once in the model; a file belongs to its most specific claim.",
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/claim"
            }
          }
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "from", "to", "label"],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "from": {
            "$ref": "#/$defs/id"
          },
          "to": {
            "$ref": "#/$defs/id"
          },
          "label": {
            "$ref": "#/$defs/text"
          },
          "details": {
            "$ref": "#/$defs/details"
          },
          "status": {
            "$ref": "#/$defs/status"
          },
          "files": {
            "description": "The repository files that evidence the relation.",
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/file"
            }
          }
        }
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "members"],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "label": {
            "$ref": "#/$defs/text"
          },
          "members": {
            "$ref": "#/$defs/references",
            "minItems": 1
          }
        }
      }
    },
    "views": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "oneOf": [
          {
            "required": ["tiers"]
          },
          {
            "required": ["members"]
          }
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "title": {
            "$ref": "#/$defs/text"
          },
          "question": {
            "$ref": "#/$defs/text"
          },
          "summary": {
            "$ref": "#/$defs/text"
          },
          "tiers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                {
                  "$ref": "#/$defs/id"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "label", "members"],
                  "properties": {
                    "id": {
                      "$ref": "#/$defs/id"
                    },
                    "label": {
                      "$ref": "#/$defs/text"
                    },
                    "members": {
                      "$ref": "#/$defs/references",
                      "minItems": 1
                    }
                  }
                }
              ]
            }
          },
          "members": {
            "$ref": "#/$defs/references",
            "minItems": 1
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "description": "The repository paths the model describes and those it leaves out, each with a reason; a path holding *, ? or [ is a glob, and any other path ending in a slash names a directory.",
      "additionalProperties": false,
      "properties": {
        "include": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "reason"],
            "properties": {
              "path": {
                "$ref": "#/$defs/path"
              },
              "reason": {
                "$ref": "#/$defs/text"
              }
            }
          }
        }
      }
    },
    "overview": {
      "description": "The overview a model states: blocks without positions, which the publisher lays out on one page.",
      "type": "object",
      "additionalProperties": false,
      "required": ["claim", "lead", "course"],
      "properties": {
        "claim": {
          "$ref": "#/$defs/text"
        },
        "lead": {
          "$ref": "#/$defs/text"
        },
        "course": {
          "$ref": "#/$defs/overviewCourse"
        },
        "blocks": {
          "description": "The blocks after the course, in the order the page sets them.",
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/overviewFurtherCourse"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["title", "items"],
                "properties": {
                  "title": {
                    "$ref": "#/$defs/text"
                  },
                  "items": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 2,
                      "items": {
                        "$ref": "#/$defs/text"
                      }
                    }
                  },
                  "text": {
                    "$ref": "#/$defs/text"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["title", "columns", "rows"],
                "properties": {
                  "title": {
                    "$ref": "#/$defs/text"
                  },
                  "columns": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "$ref": "#/$defs/text"
                    }
                  },
                  "rows": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/$defs/text"
                      }
                    }
                  },
                  "text": {
                    "$ref": "#/$defs/text"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["title", "lists"],
                "properties": {
                  "title": {
                    "$ref": "#/$defs/text"
                  },
                  "lists": {
                    "type": "array",
                    "minItems": 2,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["title", "items"],
                      "properties": {
                        "title": {
                          "$ref": "#/$defs/text"
                        },
                        "items": {
                          "type": "array",
                          "minItems": 1,
                          "items": {
                            "type": "array",
                            "minItems": 2,
                            "maxItems": 2,
                            "items": {
                              "$ref": "#/$defs/text"
                            }
                          }
                        }
                      }
                    }
                  },
                  "text": {
                    "$ref": "#/$defs/text"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["title", "text"],
                "properties": {
                  "title": {
                    "$ref": "#/$defs/text"
                  },
                  "text": {
                    "$ref": "#/$defs/text"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "guide": {
      "description": "The guide composition: an Archify explainer draft relative to the model, within its directory, delivered as the page.",
      "allOf": [
        {
          "$ref": "#/$defs/path"
        },
        {
          "pattern": "[^/]\\.archify\\.md$"
        }
      ]
    },
    "edition": {
      "description": "How the print edition draws its parts and in which palette; the build chooses either the model leaves out.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "marks": {
          "description": "Each part as a strip of the files it owns, as long as its code (strip, the default with file facts), or as a card with its kind's icon (card).",
          "enum": ["strip", "card"]
        },
        "palette": {
          "description": "A built-in palette, indigo (the default), persimmon, soot or patina, or the model's own, which must pass the publisher's contrast, chroma, lightness and hue rules.",
          "oneOf": [
            {
              "enum": ["indigo", "persimmon", "soot", "patina"]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["ground", "ink", "dye"],
              "properties": {
                "ground": {
                  "$ref": "#/$defs/color"
                },
                "ink": {
                  "$ref": "#/$defs/color"
                },
                "dye": {
                  "description": "Three dye steps, from new to old.",
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3,
                  "items": {
                    "$ref": "#/$defs/color"
                  }
                },
                "accent": {
                  "description": "The accent; defaults to the oldest dye.",
                  "$ref": "#/$defs/color"
                }
              }
            }
          ]
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "\\S"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*(^|/)\\.\\.?(/|$))[^\\\\\\u0000\\n\\r]+$"
    },
    "claim": {
      "description": "A claimed path: a directory ending in a slash or one file, without a glob.",
      "allOf": [
        {
          "$ref": "#/$defs/path"
        },
        {
          "pattern": "^[^*?\\[]+$"
        }
      ]
    },
    "file": {
      "description": "One repository file, without a glob.",
      "allOf": [
        {
          "$ref": "#/$defs/path"
        },
        {
          "pattern": "^[^*?\\[]*[^*?\\[/]$"
        }
      ]
    },
    "status": {
      "enum": ["implemented", "planned", "retired"]
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "references": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "details": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^(?![0-9]+$)[^:\\n]{1,64}$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "$ref": "#/$defs/text"
          },
          {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/text"
            }
          }
        ]
      }
    },
    "overviewStation": {
      "description": "A station of a course: a label, or the part of the model it is, with an optional note.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "$ref": "#/$defs/text"
        },
        "part": {
          "$ref": "#/$defs/id"
        },
        "note": {
          "$ref": "#/$defs/text"
        }
      },
      "anyOf": [
        {
          "required": ["label"]
        },
        {
          "required": ["part"]
        }
      ]
    },
    "overviewStep": {
      "description": "A step of the course: a label or a part, a note, a text; its stations, or forks of branches, run on 2 to 4 parallel tracks, counted or named.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "$ref": "#/$defs/text"
        },
        "part": {
          "$ref": "#/$defs/id"
        },
        "note": {
          "$ref": "#/$defs/text"
        },
        "text": {
          "$ref": "#/$defs/text"
        },
        "stations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/overviewStation"
              },
              {
                "$ref": "#/$defs/overviewFork"
              }
            ]
          }
        },
        "tracks": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 2,
              "maximum": 4
            },
            {
              "type": "array",
              "minItems": 2,
              "maxItems": 4,
              "items": {
                "$ref": "#/$defs/text"
              }
            }
          ]
        }
      },
      "anyOf": [
        {
          "required": ["label"]
        },
        {
          "required": ["part"]
        }
      ]
    },
    "overviewCourse": {
      "description": "The course across the overview: its steps in order and the lines from one step or station to others.",
      "type": "object",
      "additionalProperties": false,
      "required": ["steps"],
      "properties": {
        "steps": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/overviewStep"
          }
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to", "label"],
            "properties": {
              "from": {
                "$ref": "#/$defs/id"
              },
              "to": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/id"
                }
              },
              "label": {
                "$ref": "#/$defs/text"
              }
            }
          }
        },
        "text": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "overviewFurtherCourse": {
      "description": "A further course: a title and stations, a labelled step, one outcome that leaves a station, a text.",
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "stations"],
      "properties": {
        "title": {
          "$ref": "#/$defs/text"
        },
        "note": {
          "$ref": "#/$defs/text"
        },
        "text": {
          "$ref": "#/$defs/text"
        },
        "stations": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/overviewStation"
          }
        },
        "pass": {
          "type": "object",
          "additionalProperties": false,
          "required": ["after", "label"],
          "properties": {
            "after": {
              "$ref": "#/$defs/id"
            },
            "label": {
              "$ref": "#/$defs/text"
            }
          }
        },
        "aside": {
          "type": "object",
          "additionalProperties": false,
          "required": ["from", "label"],
          "properties": {
            "from": {
              "$ref": "#/$defs/id"
            },
            "label": {
              "$ref": "#/$defs/text"
            }
          }
        }
      }
    },
    "overviewFork": {
      "description": "A fork: two branches or more side by side at one place of a course.",
      "type": "object",
      "additionalProperties": false,
      "required": ["branches"],
      "properties": {
        "branches": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/overviewStation"
          }
        }
      }
    }
  }
}
