{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://architecture-publisher.local/schemas/model.json",
  "title": "Architecture Publisher model",
  "description": "An explicit architecture of one repository: components, relations, the files they own and cite, and optional editorial decisions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "id", "title", "question", "components", "relations"],
  "properties": {
    "format": {
      "description": "The kind of file: an Architecture Publisher model.",
      "const": "architecture-publisher.model"
    },
    "version": {
      "description": "`archpub migrate` converts a model of an earlier version.",
      "const": 3
    },
    "id": {
      "description": "The model's id; it names the delivery's files and the directory `archpub publish` copies them to.",
      "allOf": [
        {
          "$ref": "#/$defs/id"
        },
        {
          "not": {
            "pattern": "^(?:con|prn|aux|nul|com[0-9]|lpt[0-9])(?:\\.|$)|\\.$"
          }
        }
      ]
    },
    "locale": {
      "description": "The language the model is written in; the publisher sets its own words in it.",
      "enum": ["en", "zh-CN", "zh-TW", "es", "ko"],
      "default": "en"
    },
    "title": {
      "description": "The edition's title, and the title of any view without its own.",
      "$ref": "#/$defs/text"
    },
    "question": {
      "description": "The question the model answers, and that of any view without its own: on the edition's title page and at the head of the page.",
      "$ref": "#/$defs/text"
    },
    "summary": {
      "description": "A short answer under the question on the title page, and the page's conclusion.",
      "$ref": "#/$defs/text"
    },
    "editors": {
      "description": "Who edited the model: the edition's authors.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": {
            "$ref": "#/$defs/text"
          },
          "url": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "license": {
      "description": "The licence of the model and its editions, as an SPDX licence expression such as `MIT`.",
      "type": "string",
      "pattern": "^\\(?[A-Za-z0-9.+-]+\\)?(?: (?:AND|OR|WITH) \\(?[A-Za-z0-9.+-]+\\)?)*$"
    },
    "scope": {
      "description": "What the model covers and leaves out, beside the edition's contents and in the page's scope.",
      "$ref": "#/$defs/text"
    },
    "limits": {
      "description": "Known limits of the description, printed with the scope.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "repository": {
      "description": "The repository the model describes, pinned at one commit.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "revision"],
      "properties": {
        "name": {
          "$ref": "#/$defs/text"
        },
        "url": {
          "$ref": "#/$defs/text"
        },
        "revision": {
          "type": "string",
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "browse": {
          "description": "A URL that shows one file of the repository at one revision, with the placeholders {revision} and {path}. Without it, an https url on github.com or gitlab.com implies url/blob/{revision}/{path} or url/-/blob/{revision}/{path}, without a trailing .git.",
          "type": "string",
          "pattern": "\\{revision\\}[\\s\\S]*\\{path\\}|\\{path\\}[\\s\\S]*\\{revision\\}"
        }
      }
    },
    "kinds": {
      "description": "The catalog of kinds, keyed by a kind's id.",
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "label": {
            "$ref": "#/$defs/text"
          },
          "category": {
            "enum": [
              "person",
              "external",
              "frontend",
              "backend",
              "database",
              "cloud",
              "messagebus",
              "security"
            ],
            "default": "backend"
          },
          "icon": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        }
      }
    },
    "components": {
      "description": "The parts the model describes, those of the categories `person` and `external` among them.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "label": {
            "$ref": "#/$defs/text"
          },
          "kind": {
            "$ref": "#/$defs/id"
          },
          "details": {
            "$ref": "#/$defs/details"
          },
          "status": {
            "$ref": "#/$defs/status"
          },
          "files": {
            "description": "The repository paths the component owns: a directory ending in a slash or one file, each claimed once in the model; a file belongs to its most specific claim.",
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/claim"
            }
          }
        }
      }
    },
    "relations": {
      "description": "The relations between components.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "from", "to", "label"],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "from": {
            "$ref": "#/$defs/id"
          },
          "to": {
            "$ref": "#/$defs/id"
          },
          "label": {
            "$ref": "#/$defs/text"
          },
          "details": {
            "$ref": "#/$defs/details"
          },
          "status": {
            "$ref": "#/$defs/status"
          },
          "files": {
            "description": "The repository files that evidence the relation.",
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/file"
            }
          }
        }
      }
    },
    "groups": {
      "description": "Named sets of components.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "members"],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "label": {
            "$ref": "#/$defs/text"
          },
          "members": {
            "$ref": "#/$defs/references",
            "minItems": 1
          }
        }
      }
    },
    "views": {
      "description": "The views, each one plate of the edition and one panel of the page.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "oneOf": [
          {
            "required": ["tiers"]
          },
          {
            "required": ["members"]
          }
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "title": {
            "$ref": "#/$defs/text"
          },
          "question": {
            "$ref": "#/$defs/text"
          },
          "summary": {
            "$ref": "#/$defs/text"
          },
          "tiers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                {
                  "$ref": "#/$defs/id"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "label", "members"],
                  "properties": {
                    "id": {
                      "$ref": "#/$defs/id"
                    },
                    "label": {
                      "$ref": "#/$defs/text"
                    },
                    "members": {
                      "$ref": "#/$defs/references",
                      "minItems": 1
                    }
                  }
                }
              ]
            }
          },
          "members": {
            "$ref": "#/$defs/references",
            "minItems": 1
          },
          "composition": {
            "description": "The composition the view's plate is drawn in: `tiers`, rows of cards joined by lines; `matrix`, a row and a column for each part and a cell for the relations from one part to another; `radial`, the part related to the most others at the centre and the others round it; or `spine`, the view's main path folded into rows across the plate, the other parts beside their stations. Without it, a view that declares no tiers is drawn round that part where it relates to most of the others and drives them, along its main path where its parts and relations lie mostly along that path, or as a matrix where its figure in tiers would tangle. A matrix, a radial figure or a spine that cannot be drawn in the plate is drawn in tiers, with a warning.",
            "enum": ["tiers", "matrix", "radial", "spine"]
          }
        }
      }
    },
    "coverage": {
      "description": "The repository paths the model describes and those it leaves out.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "include": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "reason"],
            "properties": {
              "path": {
                "$ref": "#/$defs/path"
              },
              "reason": {
                "$ref": "#/$defs/text"
              }
            }
          }
        }
      }
    },
    "overview": {
      "description": "The overview: what one page after the contents says, as blocks without positions, which the publisher lays out.",
      "type": "object",
      "additionalProperties": false,
      "required": ["claim", "lead", "course"],
      "properties": {
        "claim": {
          "$ref": "#/$defs/text"
        },
        "lead": {
          "$ref": "#/$defs/text"
        },
        "course": {
          "$ref": "#/$defs/overviewCourse"
        },
        "blocks": {
          "description": "The blocks after the course, in the order the page sets them.",
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/overviewFurtherCourse"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["title", "items"],
                "properties": {
                  "title": {
                    "$ref": "#/$defs/text"
                  },
                  "items": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 2,
                      "items": {
                        "$ref": "#/$defs/text"
                      }
                    }
                  },
                  "text": {
                    "$ref": "#/$defs/text"
                  },
                  "view": {
                    "description": "The view that enlarges this step or block: the overview sets its plate's number here, as a link.",
                    "$ref": "#/$defs/id"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["title", "columns", "rows"],
                "properties": {
                  "title": {
                    "$ref": "#/$defs/text"
                  },
                  "columns": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "$ref": "#/$defs/text"
                    }
                  },
                  "rows": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/$defs/text"
                      }
                    }
                  },
                  "text": {
                    "$ref": "#/$defs/text"
                  },
                  "view": {
                    "description": "The view that enlarges this step or block: the overview sets its plate's number here, as a link.",
                    "$ref": "#/$defs/id"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["title", "lists"],
                "properties": {
                  "title": {
                    "$ref": "#/$defs/text"
                  },
                  "lists": {
                    "type": "array",
                    "minItems": 2,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["title", "items"],
                      "properties": {
                        "title": {
                          "$ref": "#/$defs/text"
                        },
                        "items": {
                          "type": "array",
                          "minItems": 1,
                          "items": {
                            "type": "array",
                            "minItems": 2,
                            "maxItems": 2,
                            "items": {
                              "$ref": "#/$defs/text"
                            }
                          }
                        }
                      }
                    }
                  },
                  "text": {
                    "$ref": "#/$defs/text"
                  },
                  "view": {
                    "description": "The view that enlarges this step or block: the overview sets its plate's number here, as a link.",
                    "$ref": "#/$defs/id"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["title", "text"],
                "properties": {
                  "title": {
                    "$ref": "#/$defs/text"
                  },
                  "text": {
                    "$ref": "#/$defs/text"
                  },
                  "view": {
                    "description": "The view that enlarges this step or block: the overview sets its plate's number here, as a link.",
                    "$ref": "#/$defs/id"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "guide": {
      "description": "The guide: an Archify explainer draft, named by its path from the model, which the page delivers in place of the one the publisher writes.",
      "allOf": [
        {
          "$ref": "#/$defs/path"
        },
        {
          "pattern": "[^/]\\.archify\\.md$"
        }
      ]
    },
    "edition": {
      "description": "The print edition's palette.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "palette": {
          "description": "A built-in palette, or the model's own, which must pass the publisher's contrast, chroma, lightness and hue rules.",
          "default": "indigo",
          "oneOf": [
            {
              "enum": ["indigo", "persimmon", "soot", "patina"]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["ground", "ink", "dye"],
              "properties": {
                "ground": {
                  "$ref": "#/$defs/color"
                },
                "ink": {
                  "$ref": "#/$defs/color"
                },
                "dye": {
                  "description": "Three dye steps, from new to old.",
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3,
                  "items": {
                    "$ref": "#/$defs/color"
                  }
                },
                "accent": {
                  "description": "The accent; defaults to the oldest dye.",
                  "$ref": "#/$defs/color"
                }
              }
            }
          ]
        }
      }
    },
    "$schema": {
      "description": "The schema an editor checks the model against; the publisher ignores it.",
      "type": "string"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "\\S",
      "not": {
        "pattern": "\\u0000"
      }
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?![\\s\\S]*(^|/)\\.\\.?(/|$))(?![\\s\\S]*//)[^\\\\\\u0000\\n\\r]+$"
    },
    "claim": {
      "description": "A claimed path: a directory ending in a slash or one file, without a glob.",
      "allOf": [
        {
          "$ref": "#/$defs/path"
        },
        {
          "pattern": "^[^*?\\[]+$"
        }
      ]
    },
    "file": {
      "description": "One repository file, without a glob.",
      "allOf": [
        {
          "$ref": "#/$defs/path"
        },
        {
          "pattern": "^[^*?\\[]*[^*?\\[/]$"
        }
      ]
    },
    "status": {
      "enum": ["implemented", "planned", "retired"]
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "references": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "details": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^(?![0-9]+$)[^:\\n]{1,64}$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "$ref": "#/$defs/text"
          },
          {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/text"
            }
          }
        ]
      }
    },
    "overviewStation": {
      "description": "A station of a course: a label, or the part of the model it is, with an optional note.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "$ref": "#/$defs/text"
        },
        "part": {
          "$ref": "#/$defs/id"
        },
        "note": {
          "$ref": "#/$defs/text"
        },
        "view": {
          "description": "The view that enlarges this step or block: the overview sets its plate's number here, as a link.",
          "$ref": "#/$defs/id"
        }
      },
      "anyOf": [
        {
          "required": ["label"]
        },
        {
          "required": ["part"]
        }
      ]
    },
    "overviewStep": {
      "description": "A step of the course: a label or a part, a note, a text, and its stations or forks of branches.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "$ref": "#/$defs/text"
        },
        "part": {
          "$ref": "#/$defs/id"
        },
        "note": {
          "$ref": "#/$defs/text"
        },
        "view": {
          "description": "The view that enlarges this step or block: the overview sets its plate's number here, as a link.",
          "$ref": "#/$defs/id"
        },
        "text": {
          "$ref": "#/$defs/text"
        },
        "stations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/overviewStation"
              },
              {
                "$ref": "#/$defs/overviewFork"
              }
            ]
          }
        }
      },
      "anyOf": [
        {
          "required": ["label"]
        },
        {
          "required": ["part"]
        }
      ]
    },
    "overviewCourse": {
      "description": "The course across the overview: its steps in order and the lines from one step or station to others.",
      "type": "object",
      "additionalProperties": false,
      "required": ["steps"],
      "properties": {
        "steps": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/overviewStep"
          }
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to", "label"],
            "properties": {
              "from": {
                "$ref": "#/$defs/id"
              },
              "to": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/id"
                }
              },
              "label": {
                "$ref": "#/$defs/text"
              }
            }
          }
        },
        "text": {
          "$ref": "#/$defs/text"
        },
        "parallel": {
          "description": "Stretches of the course on parallel tracks, each from one station or step without stations to another, on 2 to 4 tracks, counted or named.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to", "tracks"],
            "properties": {
              "from": {
                "$ref": "#/$defs/id"
              },
              "to": {
                "$ref": "#/$defs/id"
              },
              "tracks": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 2,
                    "maximum": 4
                  },
                  {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 4,
                    "items": {
                      "$ref": "#/$defs/text"
                    }
                  }
                ]
              }
            }
          }
        },
        "spurs": {
          "description": "Stations beside the course, each leaving one of its points: an input that joins it or a store it reads.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["at"],
            "properties": {
              "at": {
                "$ref": "#/$defs/id"
              },
              "id": {
                "$ref": "#/$defs/id"
              },
              "label": {
                "$ref": "#/$defs/text"
              },
              "part": {
                "$ref": "#/$defs/id"
              },
              "note": {
                "$ref": "#/$defs/text"
              },
              "view": {
                "description": "The view that enlarges this step or block: the overview sets its plate's number here, as a link.",
                "$ref": "#/$defs/id"
              }
            },
            "anyOf": [
              {
                "required": ["label"]
              },
              {
                "required": ["part"]
              }
            ]
          }
        },
        "passes": {
          "description": "Labels on stretches of the course, each on the stretch after one point, before the next.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["after", "label"],
            "properties": {
              "after": {
                "$ref": "#/$defs/id"
              },
              "label": {
                "$ref": "#/$defs/text"
              }
            }
          }
        }
      }
    },
    "overviewFurtherCourse": {
      "description": "A further course: a title and stations, a labelled step, one outcome that leaves a station, a text.",
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "stations"],
      "properties": {
        "title": {
          "$ref": "#/$defs/text"
        },
        "stations": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/overviewStation"
          }
        },
        "note": {
          "$ref": "#/$defs/text"
        },
        "pass": {
          "type": "object",
          "additionalProperties": false,
          "required": ["after", "label"],
          "properties": {
            "after": {
              "$ref": "#/$defs/id"
            },
            "label": {
              "$ref": "#/$defs/text"
            }
          }
        },
        "aside": {
          "type": "object",
          "additionalProperties": false,
          "required": ["from", "label"],
          "properties": {
            "from": {
              "$ref": "#/$defs/id"
            },
            "label": {
              "$ref": "#/$defs/text"
            }
          }
        },
        "text": {
          "$ref": "#/$defs/text"
        },
        "view": {
          "description": "The view that enlarges this step or block: the overview sets its plate's number here, as a link.",
          "$ref": "#/$defs/id"
        }
      }
    },
    "overviewFork": {
      "description": "A fork: two branches or more side by side at one place of a course.",
      "type": "object",
      "additionalProperties": false,
      "required": ["branches"],
      "properties": {
        "branches": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/overviewStation"
          }
        }
      }
    }
  }
}
