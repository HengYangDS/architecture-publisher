  "version": 1,
  "id": "architecture-publisher",
  "title": "Architecture Publisher",
  "question": "How does Architecture Publisher turn an architecture model into a poster and a map?",
  "summary": "An editor runs archpub on a model or a LikeC4 workspace. One build validates the model, verifies its sources, plans the views, lays each out on one grid and writes posters, a native Archify map and a manifest of their digests.",
  "attribution": "the Architecture Publisher maintainers",
  "scope": "The publisher package and its vendored supplies; not the repository's quality tooling or CI",
  "limits": [
    "Curated from the selected modules at the pinned revision; relations describe calls between those modules, not every function"
